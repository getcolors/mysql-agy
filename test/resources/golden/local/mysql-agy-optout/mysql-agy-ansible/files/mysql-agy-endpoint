#!/usr/bin/env bash
# Managed by Colors mysql-agy — claim the client endpoint for this member.
set -euo pipefail

# shellcheck source=/dev/null
. /usr/local/lib/mysql-agy-lib
# shellcheck source=/dev/null
. "$MYSQL_HA_ETC/secrets.env"

is_primary || exit 0

[ "$(q 'SELECT @@super_read_only')" = "0" ] || exit 0

api="https://api.digitalocean.com/v2/reserved_ips/${RESERVED_IP}"

do_api() {
  curl -sS --fail-with-body --max-time 20 \
    -H "Authorization: Bearer ${DO_TOKEN}" \
    -H 'Content-Type: application/json' "$@"
}

holder() { do_api "$api" | jq -r '.reserved_ip.droplet.id // empty'; }

current=$(holder || true)
[ "$current" = "$DROPLET_ID" ] && exit 0

if [ -n "$current" ]; then
  log "reserved IP ${RESERVED_IP} is held by droplet ${current}; unassigning"
  do_api -X POST -d '{"type":"unassign"}' "${api}/actions" >/dev/null
  for _ in $(seq 1 30); do
    sleep 2
    [ -z "$(holder || true)" ] && break
  done
fi

log "claiming reserved IP ${RESERVED_IP} for droplet ${DROPLET_ID}"
do_api -X POST -d "{\"type\":\"assign\",\"droplet_id\":${DROPLET_ID}}" \
  "${api}/actions" >/dev/null

for _ in $(seq 1 30); do
  sleep 2
  if [ "$(holder || true)" = "$DROPLET_ID" ]; then
    log "reserved IP ${RESERVED_IP} now serves ${NODE_NAME}"
    exit 0
  fi
done

log "reserved IP ${RESERVED_IP} was not confirmed on ${NODE_NAME}"
exit 1
